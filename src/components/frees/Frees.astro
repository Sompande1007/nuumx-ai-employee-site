---
// "It doesn't replace your team. It frees them." A dark section right after What it replaces, told as a calendar
// defrag: one salesperson's week is packed with small grey busywork blocks; a mist-blue sweep passes across it day by
// day and each block flies into Riya's panel, ticking up its task; then the emptied week refills with fewer, bigger
// white blocks of selling time. The summary line says the same in words, and the calendar itself is decorative.
// Blocks are positioned from their hours with CSS (--s start, --d duration). Copy in src/data/frees.ts.
import '../../styles/frees.css';
import { FREES as F } from '../../data/frees';

const hour = (h: number) => {
  const x = h > 12 ? h - 12 : h;
  return `${Math.floor(x)}${x % 1 ? ':30' : ''} ${h >= 12 ? 'pm' : 'am'}`;
};
const pos = (s: number, d: number) => `--s:${s - F.start};--d:${d}`;
---
<section class="fr" id="frees" aria-labelledby="frTitle">
  <div class="fr-in">
    <h2 id="frTitle">{F.title}<span class="fr-soft">{F.titleSoft}</span></h2>

    <div class="fr-board" aria-hidden="true">
      <div class="fr-week">
        <div class="fr-wtop"><h3 class="fr-wt" data-before={F.weekBefore[0]} data-after={F.weekAfter[0]}>{F.weekBefore[0]}</h3><span class="fr-ws" data-before={F.weekBefore[1]} data-after={F.weekAfter[1]}>{F.weekBefore[1]}</span></div>
        <div class="fr-grid" style={`--hours:${F.end - F.start}`}>
          <div></div>
          {F.days.map(([d, n], i) => <div class={`fr-dh fr-d${i + 1}`}><b>{d}</b>{n}</div>)}
          <div class="fr-hours">{[10, 12, 14, 16, 18].map((h) => <span style={`--s:${h - F.start}`}>{hour(h)}</span>)}</div>
          {F.days.map((_, i) => (
            <div class={`fr-col fr-d${i + 1}`} data-d={i}>
              {F.busy.filter((b) => b[0] === i).map(([, s, d, label, t]) => (
                <div class={`fr-blk fr-busy${d <= 0.5 ? ' fr-short' : ''}`} data-t={t} style={pos(s, d)}>{label}<small>{hour(s)}</small></div>
              ))}
              {F.human.filter((h) => h[0] === i).map(([, s, d, title, detail]) => (
                <div class="fr-blk fr-human" style={pos(s, d)}><b>{title}</b><small>{hour(s)} · {detail}</small></div>
              ))}
            </div>
          ))}
          <span class="fr-sweep"></span>
        </div>
      </div>
      <div class="fr-riya">
        <div class="fr-rtop"><h3>{F.riyaTitle}</h3><p>{F.riyaSub}</p></div>
        <ul class="fr-tasks">
          {F.tasks.map((t) => <li class="fr-task" data-t={t.id} data-n={F.busy.filter((b) => b[4] === t.id).length}><span class="fr-ck">✓</span>{t.label}<span class="fr-n">0</span></li>)}
        </ul>
        <div class="fr-total"><span>{F.totalLabel}</span><b class="fr-tot" data-n={F.busy.length}>0</b></div>
      </div>
    </div>

    <p class="fr-cap"><b>{F.summaryRiya}</b> {F.summaryRiyaText} <b>{F.summaryTeam}</b> {F.summaryTeamText}</p>
    <p class="fr-note">{F.note}</p>
  </div>
</section>

<script>
  import { startFrees } from '../../scripts/frees';
  startFrees();
</script>
