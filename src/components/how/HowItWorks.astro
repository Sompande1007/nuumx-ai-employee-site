---
// How it works: one lead (Priya, from the hero) followed through five channels, one moment at a time.
// Desktop and landscape tablets (wide and tall enough): the stage pins while you scroll. The phone is the hero, centred, and
// plays its moments (notification then app, the call from the top, sleeping overnight and waking on Rahul's lock screen).
// Behind it the time rolls as a huge faint odometer; a chip above names the time and channel; after the phone settles, one
// callout per step draws a hairline to the edge of the phone, level with the part of the screen it describes.
// Phones and tablets in portrait: the same stage, stacked. The phone pins under a progress bar and a time chip, plays the
// same moments, and a short note below it changes with each step.
// Landscape phones, short screens, reduced motion and no-JS: the same steps as a plain list, each with its own phone moment.
// Proof and buttons follow in normal flow. Copy lives in src/data/how-it-works.ts; motion in src/scripts/how-it-works.ts.
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';
import '../../styles/how.css';
import '../../styles/how-stage.css';
import ribs from '../../assets/how-ribs.webp';
import PhoneScreen from './PhoneScreen.astro';
import { HOW, clockParts } from '../../data/how-it-works';

const steps = HOW.steps.map((s) => ({ ...s, ...clockParts(s.minutes) }));
---
<section class="hw" id="how" aria-labelledby="howTitle">
  <header class="hw-head">
    <h2 id="howTitle">{HOW.title} <span>{HOW.titleSoft}</span></h2>
    <p>{HOW.lede}</p>
  </header>

  <div class="hw-pin">
    <div class="hw-sticky">
      <div class="hw-bg" aria-hidden="true">
        <Picture src={ribs} alt="" formats={['avif']} fallbackFormat="webp" widths={[960, 1440, 1920]} sizes="100vw" loading="lazy" />
      </div>

      <div class="hw-frame">

        <div class="hw-mbar" aria-hidden="true">
          {steps.map((_, i) => <i class:list={{ 'is-on': i === 0 }}></i>)}
          <span class="hw-mbar-t">{steps[0].time} {steps[0].ap}</span>
        </div>

        <div class="hw-text">
          <ol class="hw-steps">
            {steps.map((s, i) => (
              <li class="hw-step" data-min={s.minutes} data-viewer={s.viewer}>
                <p class="hw-time">{s.time}<small>{s.ap}</small></p>
                <p class="hw-label"><Icon name={`material-symbols:${s.icon}`} class="icon" /><b>{s.n} {s.key}</b>{s.channel}</p>
                <h3 class="hw-title">{s.title}</h3>
                <p class="hw-body">{s.body}</p>
                <p class="hw-mem"><span>Riya remembers</span>{s.remembers}</p>
                <div class="hw-shot" aria-hidden="true">
                  <div class="hw-phone">
                    <div class="hw-scr">
                      <span class="hw-isl"></span><PhoneScreen step={i} />
                      {i === 2 && (
                        <div class="hw-banner"><span class="hw-app-ic hw-app-ic--wa"><Icon name="material-symbols:sms-outline" /></span><span><b>Interior Studio</b>Studio brochure.pdf and 3 visit slots</span><small>now</small></div>
                      )}
                      {i === 3 && (
                        <div class="hw-banner"><span class="hw-app-ic hw-app-ic--mail"><Icon name="material-symbols:mail-outline" /></span><span><b>Interior Studio</b>Your site visit, Saturday 11:00 am</span><small>now</small></div>
                      )}
                      {i === 4 && <div class="hw-black"></div>}
                    </div>
                  </div>
                  <p class="hw-cap">{s.viewer}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="hx-wm" aria-hidden="true"><span class="hx-odo"></span></div>

        <div class="hx-stage" aria-hidden="true">
          <div class="hm-prog">{steps.map(() => <i></i>)}</div>
          <p class="hm-chip"><span class="hm-odo"></span><span class="hm-dot">·</span><span class="hm-ch">{steps.map((s) => <span>{s.channel}</span>)}</span></p>
          <p class="hx-chip">
            {steps.map((s, i) => <span class:list={{ 'is-on': i === 0 }}>{s.time} {s.ap.toUpperCase()} · {s.channel.toUpperCase()}</span>)}
          </p>
          <div class="hx-phone-box">
            <div class="hw-phone">
              <div class="hw-scr">
                <span class="hw-isl"></span>
                {steps.map((_, i) => <PhoneScreen step={i} />)}
                <div class="hw-banner" data-for="2">
                  <span class="hw-app-ic hw-app-ic--wa"><Icon name="material-symbols:sms-outline" /></span>
                  <span><b>Interior Studio</b>Studio brochure.pdf and 3 visit slots</span><small>now</small>
                </div>
                <div class="hw-banner" data-for="3">
                  <span class="hw-app-ic hw-app-ic--mail"><Icon name="material-symbols:mail-outline" /></span>
                  <span><b>Interior Studio</b>Your site visit, Saturday 11:00 am</span><small>now</small>
                </div>
                <div class="hw-black"></div>
                <div class="hw-glint"></div>
              </div>
            </div>
          </div>
          <ol class="hx-notes">
            {steps.map((s, i) => (
              <li class:list={['hx-note', i % 2 ? 'hx-r' : 'hx-l']} data-target={s.target}>
                <p class="hx-step"><b>{s.n} {s.key}</b> · {s.channel}<span class="hx-step-t"> · {s.time} {s.ap}</span></p>
                <h3>{s.title}</h3>
                <p class="hx-txt">{s.note}</p>
              </li>
            ))}
          </ol>
          <svg class="hx-line"><path d="" /><circle r="4.5" cx="-10" cy="-10" /></svg>
          <div class="hx-dots">{steps.map((_, i) => <i class:list={{ 'is-on': i === 0 }}></i>)}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="hw-close">
    <div class="hw-after"><p class="hw-after-l">Afterwards</p><p class="hw-after-t">{HOW.afterwards}</p></div>
    <ul class="hw-stats">
      {HOW.stats.map((s) => <li><b>{s.big}</b><span>{s.label}</span></li>)}
    </ul>
    <div class="hw-cta">
      <p>{HOW.closing}</p>
      <div class="hw-btns">
        <button class="hw-call" type="button" data-open="call" data-track="how_call"><span class="hw-call-ic glass"><Icon name="material-symbols:call-outline" class="icon" /></span>Get a call from Riya</button>
        <button class="btn-primary" type="button" data-open="demo" data-track="how_demo">Book a free demo</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { startHowItWorks } from '../../scripts/how-it-works';
  startHowItWorks();
</script>
